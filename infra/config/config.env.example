# Non-secret production configuration for /opt/leadgen/config.env
# Copy to /opt/leadgen/config.env on the VM. Do NOT put secrets here.
# Secrets are loaded from GCP Secret Manager into runtime.env by load-secrets.sh.
# Auth secrets (AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) must live in Secret Manager.

NODE_ENV=production
APP_URL=https://demoleadgen.duckdns.org
PORT=3000

OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TIMEOUT_MS=45000

ENABLE_CRUSTDATA=true
ENABLE_EMAIL_VERIFIER=false
CRUSTDATA_API_BASE_URL=https://api.crustdata.com
CRUSTDATA_API_VERSION=2025-11-01
CRUSTDATA_COMPANY_RPM=12
CRUSTDATA_PERSON_SEARCH_RPM=24
CRUSTDATA_PERSON_ENRICH_RPM=12
CRUSTDATA_CACHE_TTL_HOURS=168
CRUSTDATA_TIMEOUT_MS=8000
CRUSTDATA_PEOPLE_TIMEOUT_MS=12000
CRUSTDATA_MAX_PEOPLE_PER_RUN=25

CRAWL_MAX_SUCCESSFUL_PAGES=10
CRAWL_MAX_ATTEMPTS=25
CRAWL_MAX_DEPTH=2
CRAWL_CONCURRENCY=1
CRAWL_TIMEOUT_MS=90000
CRAWL_PAGE_TIMEOUT_MS=15000

AI_EXTRACTION_CONCURRENCY=1
RESOLUTION_CONCURRENCY=1
PERSON_ENRICHMENT_CONCURRENCY=1
WORKER_CONCURRENCY=1

RAW_DATA_RETENTION_DAYS=7

PUBLIC_RUN_LIMIT_PER_IP_DAY=3
PUBLIC_GLOBAL_RUN_LIMIT_DAY=50
PUBLIC_ACTIVE_RUNS_PER_IP=1

LOG_LEVEL=info
TRUSTED_PROXY_HOPS=1
PLAYWRIGHT_HEADLESS=true
