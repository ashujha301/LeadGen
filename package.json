{
  "name": "leadgen-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed lead intelligence demo",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev --port 3000",
    "dev:worker": "tsx watch --import dotenv/config src/server/worker/index.ts",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "next build",
    "build:worker": "tsup",
    "start:web": "next start",
    "start:worker": "node --import dotenv/config dist/worker/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:cleanup": "tsx scripts/cleanup-old-data.ts",
    "db:repair-garbage-contacts": "tsx --import dotenv/config scripts/repair-garbage-contacts.ts",
    "db:repair-hvl-duplicates": "tsx --import dotenv/config scripts/repair-hvl-duplicate-leads.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.1.0",
    "@tanstack/react-table": "^8.20.6",
    "bottleneck": "^2.19.5",
    "cytoscape": "^3.30.4",
    "drizzle-orm": "^0.38.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "openai": "^4.104.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
