{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "incremental": false,
    "plugins": [],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/server/worker/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/app/**", "src/features/**", "src/components/**"]
}
