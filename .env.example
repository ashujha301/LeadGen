NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

DATABASE_URL=postgresql://leadgen:leadgen@localhost:5432/leadgen?sslmode=disable

# OpenAI (page extraction, search intent, lead explanation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TIMEOUT_MS=45000

# Optional enrichment (graceful degradation when disabled or missing keys)
CRUSTDATA_API_KEY=
CRUSTDATA_API_BASE_URL=https://api.crustdata.com
CRUSTDATA_API_VERSION=2025-11-01
CRUSTDATA_COMPANY_RPM=12
CRUSTDATA_PERSON_SEARCH_RPM=24
CRUSTDATA_PERSON_ENRICH_RPM=12
CRUSTDATA_CACHE_TTL_HOURS=168
EMAIL_VERIFIER_API_KEY=
ENABLE_CRUSTDATA=false
ENABLE_EMAIL_VERIFIER=false
CRUSTDATA_TIMEOUT_MS=8000
CRUSTDATA_PEOPLE_TIMEOUT_MS=12000
CRUSTDATA_MAX_PEOPLE_PER_RUN=25
AI_EXTRACTION_CONCURRENCY=2
RESOLUTION_CONCURRENCY=2
PERSON_ENRICHMENT_CONCURRENCY=3

# Dynamic website crawl (homepage seed only; discovered links prioritized)
CRAWL_MAX_SUCCESSFUL_PAGES=10
CRAWL_MAX_ATTEMPTS=25
CRAWL_MAX_DEPTH=2
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT_MS=90000
CRAWL_PAGE_TIMEOUT_MS=15000

RAW_DATA_RETENTION_DAYS=7
RAW_ARTIFACTS_BUCKET=

# Public demo quotas
PUBLIC_RUN_LIMIT_PER_IP_DAY=3
PUBLIC_GLOBAL_RUN_LIMIT_DAY=50
PUBLIC_ACTIVE_RUNS_PER_IP=1
IP_HASH_SALT=replace-with-a-secret

LOG_LEVEL=info
TRUSTED_PROXY_HOPS=1
